#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/safe-lib
source "$SCRIPT_DIR/safe-lib"

ensure_lab_repo

branch="quickdraw-$(date +%s)"
prepare_branch "$branch"
git commit --allow-empty -m "$(generate_commit_message 0)"
create_and_merge_pr \
  "$branch" \
  "quickdraw: an expertly fenced contribution appearing with comedic haste" \
  "Created by safe-quickdraw after verifying the repo is private, self-owned, and explicitly addressed by --repo/--head."
