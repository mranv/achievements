#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/safe-lib
source "$SCRIPT_DIR/safe-lib"

ensure_lab_repo

for i in $(seq 1 "$PULLSHARK_ITERATIONS"); do
  branch="pullshark-$i-$(date +%s)"
  prepare_branch "$branch"
  git commit --allow-empty -m "$(generate_commit_message "$i")"
  create_and_merge_pr \
    "$branch" \
    "pullshark: a meticulously guarded private-repo badge wobble #$i" \
    "Created by safe-pullshark after verifying the repo is private, self-owned, and explicitly addressed by --repo/--head."
  sleep "$SLEEP_SECONDS"
done
